# Zkopíruj na .env a vyplň. docker-compose.yml čte tyto proměnné.

POSTGRES_PASSWORD=zmen_me

# Fine-grained GitHub Personal Access Token, scope POUZE "Issues: write"
# na repozitář jeKral/TightPrint.md. Nikdy nepoužívej classic token s
# plným přístupem k repu/organizaci.
GITHUB_TOKEN=

GITHUB_REPO=jeKral/TightPrint.md
