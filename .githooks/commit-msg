#!/usr/bin/env bash
# Vynucuje Conventional Commits (https://www.conventionalcommits.org/), protože
# na nich stojí automatické semver bumpování přes semantic-release.
# Nainstaluje se jednorázově: git config core.hooksPath .githooks
# (udělá to i `npm install` přes "prepare" skript v package.json).
set -euo pipefail
msg_file="$1"
first_line=$(head -n1 "$msg_file")

if command -v npx >/dev/null 2>&1 && [ -f node_modules/.bin/commitlint ]; then
  npx --no-install commitlint --edit "$msg_file" && exit 0
fi

# Fallback bez node_modules: základní regex pro "type(scope)!: subject".
pattern='^(feat|fix|perf|refactor|docs|style|test|build|ci|chore|revert)(\([a-z0-9.,\/-]+\))?!?: .{1,100}$'
if [[ ! "$first_line" =~ $pattern ]]; then
  echo "✗ Commit message neodpovídá Conventional Commits:" >&2
  echo "    $first_line" >&2
  echo "" >&2
  echo "  Očekávaný tvar: type(scope)?: subject" >&2
  echo "  type je jedno z: feat fix perf refactor docs style test build ci chore revert" >&2
  echo "  Příklad: fix(pdf): oprava mezer kolem <hr>" >&2
  echo "  Breaking change: feat!: ... nebo řádek 'BREAKING CHANGE: ...' v těle" >&2
  echo "" >&2
  echo "  Viz docs/VERSIONING.md." >&2
  exit 1
fi
